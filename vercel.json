{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "VITE_TRIAD_SERVER=/api npm run build",
      "outputDirectory": "dist"
    },
    "server": {
      "root": "server",
      "runtime": "node",
      "entrypoint": "server.mjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
